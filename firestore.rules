rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function dispatcher() {
      return signedIn() && request.auth.token.get('dispatcher', false) == true;
    }
    function validPostcode(state, code) {
      return code is string && code.matches('^[0-9]{4}$') && (
        (state == 'NSW' && ((code >= '1000' && code <= '2599') || (code >= '2619' && code <= '2899') || (code >= '2921' && code <= '2999'))) ||
        (state == 'ACT' && ((code >= '0200' && code <= '0299') || (code >= '2600' && code <= '2618') || (code >= '2900' && code <= '2920'))) ||
        (state == 'VIC' && ((code >= '3000' && code <= '3999') || (code >= '8000' && code <= '8999'))) ||
        (state == 'QLD' && ((code >= '4000' && code <= '4999') || (code >= '9000' && code <= '9999'))) ||
        (state == 'SA' && code >= '5000' && code <= '5999') ||
        (state == 'WA' && ((code >= '6000' && code <= '6797') || (code >= '6800' && code <= '6999'))) ||
        (state == 'TAS' && code >= '7000' && code <= '7999') ||
        (state == 'NT' && code >= '0800' && code <= '0999')
      );
    }
    function validCustomer(customer) {
      return customer is map && customer.keys().hasAll(['suburb', 'state', 'postcode']) &&
        customer.keys().hasOnly(['suburb', 'state', 'postcode']) &&
        customer.suburb is string && customer.suburb.size() >= 1 && customer.suburb.size() <= 80 &&
        customer.suburb == customer.suburb.trim() && !customer.suburb.matches('(?s).*[\\x00-\\x1F\\x7F-\\x9F].*') &&
        customer.state in ['NSW', 'VIC', 'QLD', 'SA', 'WA', 'TAS', 'NT', 'ACT'] &&
        validPostcode(customer.state, customer.postcode);
    }
    match /triageJobs/{jobId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || dispatcher());
      allow create: if signedIn() && jobId.matches('^[A-Za-z0-9_-]{1,128}$') &&
        request.resource.data.keys().hasAll(['id', 'ownerId', 'createdAt', 'status', 'customer', 'description', 'media']) &&
        request.resource.data.keys().hasOnly(['id', 'ownerId', 'createdAt', 'status', 'customer', 'description', 'media']) &&
        request.resource.data.id == jobId &&
        request.resource.data.ownerId == request.auth.uid && request.resource.data.ownerId.size() <= 128 &&
        request.resource.data.createdAt is timestamp && request.resource.data.createdAt == request.time &&
        request.resource.data.status == 'RECEIVED' && validCustomer(request.resource.data.customer) &&
        request.resource.data.description is string && request.resource.data.description.size() <= 4000 &&
        request.resource.data.media is map && request.resource.data.media.keys().hasOnly(['storagePath']) &&
        request.resource.data.media.storagePath == 'jobs/' + jobId + '/photo.jpg';
      allow update, delete: if false;
    }
  }
}
